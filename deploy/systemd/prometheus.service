[Unit]
Description=Prometheus
After=network.target

[Service]
ExecStart=%h/opt/prometheus-current/prometheus --config.file=%h/opt/prometheus-config/prometheus.yml --storage.tsdb.path=%h/opt/prometheus-data --web.listen-address=127.0.0.1:9090
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/opt/prometheus-data

[Install]
WantedBy=default.target
