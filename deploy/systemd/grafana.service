[Unit]
Description=Grafana
After=network.target

[Service]
Environment=GRAFANA_HOME=%h/opt/grafana
# 3001 because 3000 is commonly taken by other dev servers (e.g. StageNet/Next.js)
Environment=GF_SERVER_HTTP_PORT=3001
# Set on first boot; use `grafana cli admin reset-admin-password <pw>` to change later
Environment=GF_SECURITY_ADMIN_USER=admin
Environment=GF_SECURITY_ADMIN_PASSWORD=admin
ExecStart=%h/opt/grafana/bin/grafana server --homepath=%h/opt/grafana
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
